[
  {"text":"In 1847, a doctor found something terrifying:","start":0.096291,"end":3.540166},
  {"text":"the danger was on his colleagues’ hands.","start":3.637958,"end":5.727708},
  {"text":"Ignaz Semmelweis linked deaths after childbirth","start":6.342583,"end":8.888875},
  {"text":"to doctors arriving from autopsies.","start":8.888875,"end":10.920749},
  {"text":"He introduced handwashing","start":11.539333,"end":12.8125},
  {"text":"with chlorinated lime, a disinfectant.","start":12.8125,"end":15.087416},
  {"text":"Deaths fell dramatically.","start":15.706,"end":17.182333},
  {"text":"Cleaning their hands helped","start":17.800916,"end":18.854166},
  {"text":"stop them from carrying disease.","start":18.854166,"end":20.759249}
]
