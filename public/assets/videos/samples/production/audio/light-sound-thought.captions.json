[
  {
    "text": "What's faster:",
    "start": 0.093458,
    "end": 0.867666
  },
  {
    "text": "light, sound, or a thought?",
    "start": 1.226625,
    "end": 2.806916
  },
  {
    "text": "Light in a vacuum travels",
    "start": 3.06075,
    "end": 4.754666
  },
  {
    "text": "almost three hundred million",
    "start": 4.754666,
    "end": 6.366833
  },
  {
    "text": "meters per second.",
    "start": 6.366833,
    "end": 7.339624
  },
  {
    "text": "Sound in air",
    "start": 7.581791,
    "end": 8.472791
  },
  {
    "text": "at twenty degrees Celsius?",
    "start": 8.504666,
    "end": 10.119999
  },
  {
    "text": "About three hundred forty-three.",
    "start": 10.373833,
    "end": 11.989166
  },
  {
    "text": "Your nerve signals?",
    "start": 12.243,
    "end": 13.274166
  },
  {
    "text": "Roughly half a meter",
    "start": 13.528041,
    "end": 14.699416
  },
  {
    "text": "to over a hundred",
    "start": 14.778041,
    "end": 15.595791
  },
  {
    "text": "meters per second,",
    "start": 15.595791,
    "end": 16.603666
  },
  {
    "text": "depending on the fiber.",
    "start": 16.834125,
    "end": 17.912041
  },
  {
    "text": "But a thought doesn't have",
    "start": 18.177583,
    "end": 19.123833
  },
  {
    "text": "one travel speed.",
    "start": 19.123833,
    "end": 20.260166
  },
  {
    "text": "It's signals plus processing",
    "start": 20.514,
    "end": 22.207958
  },
  {
    "text": "across a network.",
    "start": 22.207958,
    "end": 23.262541
  },
  {
    "text": "Imagining the Moon instantly",
    "start": 23.504666,
    "end": 25.245333
  },
  {
    "text": "doesn't send anything there.",
    "start": 25.245333,
    "end": 27.269541
  },
  {
    "text": "Thinking time and travel speed",
    "start": 27.581791,
    "end": 29.290583
  },
  {
    "text": "aren't the same thing.",
    "start": 29.369166,
    "end": 30.400374
  }
]
