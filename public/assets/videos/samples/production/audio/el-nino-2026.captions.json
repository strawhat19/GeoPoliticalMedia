[
  {
    "text": "This year's El Niño",
    "start": 0.093458,
    "end": 1.179916
  },
  {
    "text": "could break a record.",
    "start": 1.179916,
    "end": 2.176083
  },
  {
    "text": "NOAA's September tenth forecast",
    "start": 2.429916,
    "end": 4.302249
  },
  {
    "text": "gives it a seventy-five percent",
    "start": 4.334125,
    "end": 5.794375
  },
  {
    "text": "chance this fall",
    "start": 5.794375,
    "end": 6.927583
  },
  {
    "text": "of beating past events",
    "start": 6.927583,
    "end": 8.294375
  },
  {
    "text": "since nineteen fifty.",
    "start": 8.294375,
    "end": 9.407416
  },
  {
    "text": "Why so strong?",
    "start": 9.661208,
    "end": 10.528875
  },
  {
    "text": "Exceptional heat at the surface,",
    "start": 10.794375,
    "end": 12.912082
  },
  {
    "text": "and deeper in the Pacific,",
    "start": 13.014,
    "end": 14.477499
  },
  {
    "text": "is helping it strengthen.",
    "start": 14.602791,
    "end": 15.715791
  },
  {
    "text": "For America's winter,",
    "start": 16.016375,
    "end": 17.141041
  },
  {
    "text": "forecasts favor a wetter South",
    "start": 17.359791,
    "end": 19.299083
  },
  {
    "text": "and warmer North.",
    "start": 19.299083,
    "end": 20.283541
  },
  {
    "text": "Elsewhere, shifting\nrain patterns",
    "start": 20.549083,
    "end": 22.394875
  },
  {
    "text": "change flood and drought risks.",
    "start": 22.394875,
    "end": 24.384
  },
  {
    "text": "But stronger doesn't mean",
    "start": 24.637833,
    "end": 25.957958
  },
  {
    "text": "worse everywhere.",
    "start": 25.957958,
    "end": 27.117666
  },
  {
    "text": "El Niño changes the odds,",
    "start": 27.383166,
    "end": 29.150374
  },
  {
    "text": "not the weather on your street.",
    "start": 29.392541,
    "end": 30.563916
  }
]
