[
  {
    "text": "You wake up.",
    "start": 0.093458,
    "end": 0.680749
  },
  {
    "text": "You sense someone in the room.",
    "start": 0.934583,
    "end": 2.012499
  },
  {
    "text": "You try to move... nothing.",
    "start": 2.266375,
    "end": 4.010207
  },
  {
    "text": "That can be sleep paralysis.",
    "start": 4.264,
    "end": 5.657416
  },
  {
    "text": "Awareness returns while",
    "start": 5.887833,
    "end": 7.102791
  },
  {
    "text": "REM sleep's muscle\nstillness briefly continues.",
    "start": 7.102791,
    "end": 10.715791
  },
  {
    "text": "Dreamlike sights\nor chest pressure",
    "start": 10.969625,
    "end": 13.285874
  },
  {
    "text": "can feel real.",
    "start": 13.411208,
    "end": 14.465791
  },
  {
    "text": "Breathing continues.",
    "start": 14.719625,
    "end": 15.949416
  },
  {
    "text": "If you feel it starting,",
    "start": 16.191583,
    "end": 17.246166
  },
  {
    "text": "remind yourself it passes.",
    "start": 17.383166,
    "end": 19.162083
  },
  {
    "text": "Relax, and try",
    "start": 19.415875,
    "end": 20.595791
  },
  {
    "text": "one tiny finger movement.",
    "start": 20.595791,
    "end": 22.000832
  },
  {
    "text": "It may help.",
    "start": 22.254666,
    "end": 22.935416
  },
  {
    "text": "There's no guaranteed\noff switch.",
    "start": 23.177583,
    "end": 24.863
  },
  {
    "text": "Regular sleep may\nreduce episodes.",
    "start": 25.116833,
    "end": 27.491499
  },
  {
    "text": "If it keeps happening",
    "start": 27.757,
    "end": 28.776541
  },
  {
    "text": "or leaves you very sleepy,",
    "start": 28.831791,
    "end": 30.482124
  },
  {
    "text": "talk to a clinician.",
    "start": 30.584125,
    "end": 31.521874
  }
]
