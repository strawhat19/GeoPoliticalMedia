[
  {
    "text": "These hands look clean.",
    "start": 0.093458,
    "end": 1.054582
  },
  {
    "text": "Under ultraviolet light?",
    "start": 1.308416,
    "end": 2.573249
  },
  {
    "text": "That's training lotion\nshowing missed spots,",
    "start": 2.827083,
    "end": 4.944749
  },
  {
    "text": "not germs.",
    "start": 5.046708,
    "end": 5.914375
  },
  {
    "text": "Now rewind to\neighteen forty-seven.",
    "start": 6.168208,
    "end": 8.624666
  },
  {
    "text": "Ignaz Semmelweis linked\ndeadly childbed fever",
    "start": 8.8785,
    "end": 11.740666
  },
  {
    "text": "to doctors coming\nfrom autopsies.",
    "start": 11.740666,
    "end": 13.472791
  },
  {
    "text": "He introduced chlorinated-lime\nhand cleaning.",
    "start": 13.726625,
    "end": 16.194791
  },
  {
    "text": "Deaths fell.",
    "start": 16.448583,
    "end": 17.152708
  },
  {
    "text": "Soap washing already existed.",
    "start": 17.406541,
    "end": 18.963458
  },
  {
    "text": "Today, scrub with soap",
    "start": 19.228958,
    "end": 20.771041
  },
  {
    "text": "for at least twenty seconds.",
    "start": 20.771041,
    "end": 22.409707
  },
  {
    "text": "Between fingers.",
    "start": 22.67525,
    "end": 23.858333
  },
  {
    "text": "Around nails.",
    "start": 24.112166,
    "end": 24.944791
  },
  {
    "text": "Rinse with clean running water,",
    "start": 25.198583,
    "end": 26.580291
  },
  {
    "text": "and dry.",
    "start": 26.717291,
    "end": 27.327916
  },
  {
    "text": "This simulated\nbefore-and-after shows",
    "start": 27.593458,
    "end": 29.672875
  },
  {
    "text": "how a tracer can reveal residue.",
    "start": 29.672875,
    "end": 31.627
  },
  {
    "text": "Less glow doesn't\nmean sterile hands.",
    "start": 31.869166,
    "end": 34.045249
  }
]
